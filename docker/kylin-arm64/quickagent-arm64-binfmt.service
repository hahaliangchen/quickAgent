[Unit]
Description=Register ARM64 QEMU for QuickAgent and AI PPT development
Requires=docker.service
After=docker.service systemd-binfmt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker run --privileged --rm --pull never tonistiigi/binfmt@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0 --install arm64

[Install]
WantedBy=multi-user.target
