[
  {
    "name": "ssh__list_servers",
    "description": "列出本地已配置的 SSH 服务器档案（按当前工作区最近使用优先排序），含环境等级、默认目录、标签与近期关联会话，不含任何凭据。",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__server_history",
    "description": "查看指定服务器的历史使用与部署记录（含关联会话 task_id、本地项目路径、远程目录与操作摘要）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "服务器档案 ID（来自 ssh__list_servers）"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "all_workspaces": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时返回全部工作区对该服务器的记录；默认优先当前工作区"
        }
      },
      "required": ["server_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__add_server",
    "description": "向本地 SSH 工作台注册新的服务器档案（含凭据安全落盘至 0600 隔离文件）；若相同 host/port/username 档案已存在则直接复用返回 server_id。每次调用强制弹出单次人工确认。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "服务器显示名称（如 3 A100、staging-api）"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "主机名或 IP 地址"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 22
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "description": "SSH 登录用户名"
        },
        "auth_type": {
          "type": "string",
          "enum": ["password", "key_file", "agent"],
          "description": "认证方式；省略时若提供 key_path 则默认 key_file，若提供 credential 则默认 password，否则 agent"
        },
        "credential": {
          "type": "string",
          "description": "可选密码（password 模式）或私钥口令（key_file 模式），仅在用户主动在当前对话提供时传入，存入本机 0600 凭据文件且绝不回显"
        },
        "key_path": {
          "type": "string",
          "description": "可选本机绝对私钥路径（仅 key_file 模式有效）"
        },
        "env_tier": {
          "type": "string",
          "enum": ["dev", "staging", "prod"],
          "default": "dev"
        },
        "require_approval": {
          "type": "boolean",
          "default": false
        },
        "default_dir": {
          "type": "string",
          "description": "可选默认远程工作目录"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["name", "host", "username"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__exec",
    "description": "通过 SSH 在指定服务器上执行远程命令（输出实时流式推送到 SSH 终端，支持最长 1800 秒超时）；prod 或需审批服务器将强制弹出人工审批。等待远端后台长任务时，请在单次 JS 程序内用循环 + 进度看门狗轮询，不要每睡几十秒就结束一步回给模型。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "服务器档案 ID"
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "description": "要执行的远程 shell 命令"
        },
        "cwd": {
          "type": "string",
          "description": "可选远程工作目录（执行前自动 cd 进入）"
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "default": 60,
          "description": "单次命令超时秒数（默认 60，最大 1800，内置 20s SSH keepalive）"
        }
      },
      "required": ["server_id", "command"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__list_dir",
    "description": "通过 SFTP 列举远程目录内容（含 modified_at / modified_ms 修改时间，支持按名称或最新修改时间倒序排列）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "default": ".",
          "description": "远程目录路径，默认当前登录目录或服务器 default_dir"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 100
        },
        "sort_by": {
          "type": "string",
          "enum": ["name", "mtime_desc"],
          "default": "name",
          "description": "排序方式：name（默认，目录优先按名称）或 mtime_desc（按最新修改时间倒序，便于排查最新日志/产物）"
        }
      },
      "required": ["server_id"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__read_file",
    "description": "通过 SFTP 按 1-based 行号分页读取远程 UTF-8 文本文件。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "远程文件路径"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536,
          "default": 16384
        }
      },
      "required": ["server_id", "path"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__write_file",
    "description": "通过 SFTP 原子写入远程 UTF-8 文本文件（支持自动建父目录与 .bak 备份）；prod 或需审批服务器强制人工审批。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "远程目标文件路径"
        },
        "content": {
          "type": "string",
          "description": "完整 UTF-8 文本内容（上限 4 MiB）"
        },
        "create_parents": {
          "type": "boolean",
          "default": false
        },
        "backup": {
          "type": "boolean",
          "default": false,
          "description": "目标已存在时先保存同名 .bak 备份"
        }
      },
      "required": ["server_id", "path", "content"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__edit_file",
    "description": "对远程 UTF-8 文本文件执行局部精确编辑（支持单条 old_text/new_text 或多条 edits 顺序原子应用、行尾空白与均匀缩进偏移自动对齐、以及可选 .bak 备份），返回带行号的改动预览。修改远程已有脚本/配置时优先使用本工具，不要先 read_file 再手拼链式 .replace() + write_file；prod 或需审批服务器强制人工审批。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "服务器档案 ID"
        },
        "path": {
          "type": "string",
          "description": "远程目标文件路径"
        },
        "old_text": {
          "type": "string",
          "description": "单条编辑快捷模式：待替换的原文片段（可配合 line_hint / replace_all 使用；与 edits 二选一）"
        },
        "new_text": {
          "type": "string",
          "description": "单条编辑快捷模式：替换后的新文本（与 old_text 成对使用）"
        },
        "line_hint": {
          "type": "integer",
          "minimum": 1,
          "description": "可选 1-based 行号提示，用于消除重复片段歧义"
        },
        "replace_all": {
          "type": "boolean",
          "default": false,
          "description": "为 true 时替换文件中所有匹配的 old_text"
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "description": "多条顺序原子编辑列表（与 old_text/new_text 二选一）",
          "items": {
            "type": "object",
            "properties": {
              "old_text": { "type": "string" },
              "new_text": { "type": "string" },
              "line_hint": { "type": "integer", "minimum": 1 },
              "replace_all": { "type": "boolean", "default": false }
            },
            "required": ["old_text", "new_text"],
            "additionalProperties": false
          }
        },
        "backup": {
          "type": "boolean",
          "default": false,
          "description": "写入前先保存同名 .bak 备份"
        }
      },
      "required": ["server_id", "path"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__upload",
    "description": "将当前本地工作区内的文件流式 SFTP 上传到远程服务器并返回 bytes_uploaded 与 sha256（严禁上传工作区外或符号链接逃逸文件）；prod 或需审批服务器强制人工审批。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string"
        },
        "local_path": {
          "type": "string",
          "description": "当前本地工作区内的相对路径（不得越出工作区或经符号链接逃逸）"
        },
        "remote_path": {
          "type": "string",
          "description": "远程目标文件完整路径"
        },
        "create_parents": {
          "type": "boolean",
          "default": false
        },
        "overwrite": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["server_id", "local_path", "remote_path"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__download",
    "description": "将远程服务器上的文件流式 SFTP 下载并原子写入当前本地工作区，同时返回 bytes_downloaded 与 sha256 便于一步校验完整性（严禁写到工作区外、内部状态目录或经符号链接逃逸，上限 512 MiB）。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string",
          "description": "服务器档案 ID"
        },
        "remote_path": {
          "type": "string",
          "description": "远程源文件完整路径"
        },
        "local_path": {
          "type": "string",
          "description": "当前本地工作区内的目标相对路径（不得越出工作区或经符号链接逃逸）"
        },
        "create_parents": {
          "type": "boolean",
          "default": true,
          "description": "本地父目录不存在时是否自动创建（默认 true）"
        },
        "overwrite": {
          "type": "boolean",
          "default": false,
          "description": "本地目标文件已存在时是否允许覆盖（默认 false）"
        }
      },
      "required": ["server_id", "remote_path", "local_path"],
      "additionalProperties": false
    }
  },
  {
    "name": "ssh__tail_log",
    "description": "高效抓取远程日志文件最后 N 行，可选按关键词大小写不敏感过滤。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "server_id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "远程日志文件路径"
        },
        "lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "filter": {
          "type": "string",
          "description": "可选过滤子串（大小写不敏感）"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 256,
          "maximum": 65536,
          "default": 24000
        }
      },
      "required": ["server_id", "path"],
      "additionalProperties": false
    }
  }
]
