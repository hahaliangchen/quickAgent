[
  {
    "name": "code_index__status",
    "description": "Inspect existing Rust/TS index cache and parse-coverage issues without rebuilding it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "rust",
            "typescript"
          ],
          "description": "typescript also indexes JS/JSX/TSX; discover the project stack first."
        },
        "workspace_root": {
          "type": "string",
          "description": "Defaults to current workspace; relative roots resolve inside it."
        }
      },
      "required": [
        "language"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "index": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "unindexed_total": {
                  "type": "integer"
                },
                "coverage_issues": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file_path": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "error": {
                        "type": "string"
                      }
                    }
                  }
                },
                "coverage_issues_truncated": {
                  "type": "boolean"
                },
                "freshness_check": {
                  "type": "string"
                },
                "files_indexed": {
                  "type": "integer"
                },
                "symbols_indexed": {
                  "type": "integer"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "files_indexed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "symbols_indexed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "code_index__index",
    "description": "Build or incrementally refresh the existing syn/SWC source index. Updates cache only, never project source. Scoped queries initialize and maintain indexes automatically; rebuilding first is optional.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "rust",
            "typescript"
          ],
          "description": "typescript also indexes JS/JSX/TSX; discover the project stack first."
        },
        "workspace_root": {
          "type": "string",
          "description": "Defaults to current workspace; relative roots resolve inside it."
        }
      },
      "required": [
        "language"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "files_indexed": {
          "type": "integer"
        },
        "symbols_indexed": {
          "type": "integer"
        },
        "generated_at_unix": {
          "type": "integer"
        },
        "index_path": {
          "type": "string"
        }
      }
    }
  },
