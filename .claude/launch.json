{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "agent-design-slides",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WORKSPACE_ROOT=runs/agent-design-5-slides",
        "AGENT_BIND=127.0.0.1:3101",
        "MCP_BIND=127.0.0.1:3100",
        "target/debug/codex-workspace-mcp"
      ],
      "port": 3101
    },
    {
      "name": "workbench-check",
      "runtimeExecutable": "E:/application/Git/usr/bin/env.exe",
      "runtimeArgs": [
        "WORKSPACE_ROOT=C:/Users/Admin/AppData/Local/Temp/wb-root",
        "AGENT_BIND=127.0.0.1:3102",
        "MCP_BIND=127.0.0.1:3103",
        "AGENT_WEB_DIR=C:/Users/Admin/AppData/Local/Temp/wb-web",
        "target/workbench-check/debug/codex-workspace-mcp.exe"
      ],
      "port": 3102
    },
    {
      "name": "workbench-check-long",
      "runtimeExecutable": "E:/application/Git/usr/bin/env.exe",
      "runtimeArgs": [
        "WORKSPACE_ROOT=C:/Users/Admin/AppData/Local/Temp/wb-root2",
        "AGENT_BIND=127.0.0.1:3104",
        "MCP_BIND=127.0.0.1:3105",
        "AGENT_WEB_DIR=C:/Users/Admin/AppData/Local/Temp/wb-web",
        "target/workbench-check/debug/codex-workspace-mcp.exe"
      ],
      "port": 3104
    },
    {
      "name": "ppt-agent",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WORKSPACE_ROOT=runs/ppt-trial",
        "PORT=3001",
        "AGENT_BIND=127.0.0.1:3001",
        "MCP_BIND=127.0.0.1:3000",
        "target/debug/codex-workspace-mcp"
      ],
      "port": 3001
    }
  ]
}