{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "agent-design-slides",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WORKSPACE_ROOT=runs/agent-design-5-slides",
        "AGENT_BIND=127.0.0.1:3101",
        "MCP_BIND=127.0.0.1:3100",
        "target/debug/codex-workspace-mcp"
      ],
      "port": 3101
    },
    {
      "name": "ppt-agent",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WORKSPACE_ROOT=runs/ppt-trial",
        "PORT=3001",
        "AGENT_BIND=127.0.0.1:3001",
        "MCP_BIND=127.0.0.1:3000",
        "target/debug/codex-workspace-mcp"
      ],
      "port": 3001
    }
  ]
}