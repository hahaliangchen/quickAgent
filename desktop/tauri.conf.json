{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grow",
  "version": "0.2.0",
  "identifier": "com.grow.agent",
  "build": { "frontendDist": "../frontend/dist" },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/grow-agent", "binaries/rg"],
    "resources": {
      "../frontend/dist/": "frontend/dist/",
      "../src/builtin_plugins/code_flow/": "src/builtin_plugins/code_flow/",
      "../src/builtin_plugins/code_index/": "src/builtin_plugins/code_index/",
      "../src/builtin_plugins/web/": "src/builtin_plugins/web/",
      "../src/builtin_plugins/git/": "src/builtin_plugins/git/",
      "../third_party/DSH-LICENSE.txt": "DSH-LICENSE.txt",
      "binaries/ripgrep-COPYING": "ripgrep-COPYING",
      "binaries/ripgrep-LICENSE-MIT": "ripgrep-LICENSE-MIT",
      "binaries/ripgrep-UNLICENSE": "ripgrep-UNLICENSE"
    }
  }
}
